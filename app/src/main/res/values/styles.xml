<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Holo theme for API 17–20; values-v21/styles.xml overrides this with Material for API 21+. -->
    <style name="GlassTheme" parent="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <color name="night">#FF05060C</color>
</resources>
